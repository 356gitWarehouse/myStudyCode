{
  "info": {
    "name": "商品管理 API",
    "description": "初期考核项目的接口集合。Day 3 起逐步启用：先跑『商品-单个』，再跑列表，最后跑新增/修改/删除。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "商品-列表（分页+多条件）",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?page=1&size=5&name=&categoryId=&minPrice=&maxPrice=",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "size", "value": "5" },
            { "key": "name", "value": "" },
            { "key": "categoryId", "value": "" },
            { "key": "minPrice", "value": "" },
            { "key": "maxPrice", "value": "" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('状态码 200', () => pm.response.to.have.status(200));",
              "pm.test('返回统一结构', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b).to.have.property('code');",
              "  pm.expect(b).to.have.property('data');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "商品-单个",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('状态码 200', () => pm.response.to.have.status(200));",
              "pm.test('含分类名（多表关联生效）', () => {",
              "  const d = pm.response.json().data;",
              "  pm.expect(d).to.have.property('categoryName');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "商品-新增",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"机械键盘\",\n  \"price\": 399.00,\n  \"stock\": 20,\n  \"categoryId\": 1,\n  \"status\": 1,\n  \"remark\": \"Postman 创建\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('状态码 201', () => pm.response.to.have.status(201));",
              "pm.test('返回新 id', () => {",
              "  const d = pm.response.json().data;",
              "  pm.expect(d).to.be.a('number');",
              "  pm.environment.set('productId', d);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "商品-修改",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"机械键盘（改）\",\n  \"price\": 349.00,\n  \"stock\": 15,\n  \"categoryId\": 1,\n  \"status\": 1\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('状态码 200', () => pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "商品-删除",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('状态码 200', () => pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "异常-查不存在的商品（验证全局异常）",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/999999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "999999"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('状态码 404', () => pm.response.to.have.status(404));",
              "pm.test('错误信息友好、无堆栈', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b.message).to.be.a('string');",
              "  pm.expect(JSON.stringify(b)).to.not.include('Exception');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "分类-列表",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": ["{{baseUrl}}"],
          "path": ["api", "categories"]
        }
      }
    },
    {
      "name": "分类-新增",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"办公用品\",\n  \"sort\": 10\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": ["{{baseUrl}}"],
          "path": ["api", "categories"]
        }
      }
    },
    {
      "name": "分类-删除（有商品时应被拦截）",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "categories", "{{categoryId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('返回 400 业务提示', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ]
}
