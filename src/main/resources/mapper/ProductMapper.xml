<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.product.mapper.ProductMapper">

    <!-- 结果映射：把 category_name 映射到 categoryName -->
    <resultMap id="ProductVOMap" type="com.example.product.vo.ProductVO">
        <id     column="id"            property="id"/>
        <result column="name"          property="name"/>
        <result column="price"         property="price"/>
        <result column="stock"         property="stock"/>
        <result column="category_id"   property="categoryId"/>
        <result column="status"        property="status"/>
        <result column="remark"        property="remark"/>
        <result column="create_time"   property="createTime"/>
        <result column="update_time"   property="updateTime"/>
        <result column="category_name" property="categoryName"/>
    </resultMap>

    <!-- 公共查询字段 -->
    <sql id="voColumns">
        SELECT p.id, p.name, p.price, p.stock, p.category_id, p.status,
               p.remark, p.create_time, p.update_time,
               c.name AS category_name
        FROM product p
        LEFT JOIN category c ON c.id = p.category_id
    </sql>

    <!-- 分页 + 多条件：名称模糊、分类、价格区间 -->
    <select id="selectVoPage" resultMap="ProductVOMap">
        <include refid="voColumns"/>
        <where>
            <if test="name != null and name != ''">
                AND p.name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="categoryId != null">
                AND p.category_id = #{categoryId}
            </if>
            <if test="minPrice != null">
                AND p.price &gt;= #{minPrice}
            </if>
            <if test="maxPrice != null">
                AND p.price &lt;= #{maxPrice}
            </if>
        </where>
        ORDER BY p.id DESC
    </select>

    <!-- 详情 -->
    <select id="selectVoById" resultMap="ProductVOMap">
        <include refid="voColumns"/>
        WHERE p.id = #{id}
    </select>

    <!-- 不分页的多表查询 -->
    <select id="selectWithCategory" resultMap="ProductVOMap">
        <include refid="voColumns"/>
        <where>
            <if test="name != null and name != ''">
                AND p.name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="categoryId != null">
                AND p.category_id = #{categoryId}
            </if>
        </where>
        ORDER BY p.id DESC
    </select>

</mapper>